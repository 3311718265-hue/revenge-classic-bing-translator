{
  "name": "revenge-classic-bing-translator",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Bilingual loaded-message translation for Revenge Classic",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:dist",
    "probe:bing": "node scripts/probe-bing.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "@types/react": "18.3.23",
    "@types/react-test-renderer": "18.3.1"
  }
}
